{
  "$defs": {
    "AgentBufferOverflow": {
      "properties": {
        "dropped": {
          "description": "Events dropped (oldest first).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "dropped"
      ],
      "type": "object"
    },
    "AgentHeartbeat": {
      "properties": {
        "agent_version": {
          "type": "string"
        },
        "clock_offset_ms": {
          "format": "int64",
          "type": "integer"
        },
        "queue_depth": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "agent_version",
        "queue_depth",
        "clock_offset_ms"
      ],
      "type": "object"
    },
    "AgentPauseChange": {
      "properties": {
        "reason": {
          "$ref": "#/$defs/PauseReason"
        }
      },
      "required": [
        "reason"
      ],
      "type": "object"
    },
    "EditorDebugSession": {
      "properties": {
        "configuration_name": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "EditorEditBurst": {
      "properties": {
        "edit_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "file_path": {
          "type": "string"
        }
      },
      "required": [
        "file_path",
        "edit_count"
      ],
      "type": "object"
    },
    "EditorFileFocus": {
      "properties": {
        "file_path": {
          "type": "string"
        },
        "language": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "file_path"
      ],
      "type": "object"
    },
    "EditorSave": {
      "properties": {
        "file_path": {
          "type": "string"
        }
      },
      "required": [
        "file_path"
      ],
      "type": "object"
    },
    "EditorWorkspaceOpen": {
      "properties": {
        "remote_url": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "workspace_path": {
          "type": "string"
        }
      },
      "required": [
        "workspace_path"
      ],
      "type": "object"
    },
    "Empty": {
      "description": "No metadata (`{}`).",
      "type": "object"
    },
    "Event": {
      "description": "One activity event, already redacted.",
      "oneOf": [
        {
          "properties": {
            "event_type": {
              "const": "presence.active",
              "type": "string"
            },
            "metadata": {
              "$ref": "#/$defs/Empty"
            }
          },
          "required": [
            "event_type",
            "metadata"
          ],
          "type": "object"
        },
        {
          "properties": {
            "event_type": {
              "const": "presence.idle",
              "type": "string"
            },
            "metadata": {
              "$ref": "#/$defs/Empty"
            }
          },
          "required": [
            "event_type",
            "metadata"
          ],
          "type": "object"
        },
        {
          "properties": {
            "event_type": {
              "const": "window.focus",
              "type": "string"
            },
            "metadata": {
              "$ref": "#/$defs/WindowFocus"
            }
          },
          "required": [
            "event_type",
            "metadata"
          ],
          "type": "object"
        },
        {
          "properties": {
            "event_type": {
              "const": "editor.workspace_open",
              "type": "string"
            },
            "metadata": {
              "$ref": "#/$defs/EditorWorkspaceOpen"
            }
          },
          "required": [
            "event_type",
            "metadata"
          ],
          "type": "object"
        },
        {
          "properties": {
            "event_type": {
              "const": "editor.file_focus",
              "type": "string"
            },
            "metadata": {
              "$ref": "#/$defs/EditorFileFocus"
            }
          },
          "required": [
            "event_type",
            "metadata"
          ],
          "type": "object"
        },
        {
          "properties": {
            "event_type": {
              "const": "editor.edit_burst",
              "type": "string"
            },
            "metadata": {
              "$ref": "#/$defs/EditorEditBurst"
            }
          },
          "required": [
            "event_type",
            "metadata"
          ],
          "type": "object"
        },
        {
          "properties": {
            "event_type": {
              "const": "editor.save",
              "type": "string"
            },
            "metadata": {
              "$ref": "#/$defs/EditorSave"
            }
          },
          "required": [
            "event_type",
            "metadata"
          ],
          "type": "object"
        },
        {
          "properties": {
            "event_type": {
              "const": "editor.debug_session",
              "type": "string"
            },
            "metadata": {
              "$ref": "#/$defs/EditorDebugSession"
            }
          },
          "required": [
            "event_type",
            "metadata"
          ],
          "type": "object"
        },
        {
          "properties": {
            "event_type": {
              "const": "git.commit",
              "type": "string"
            },
            "metadata": {
              "$ref": "#/$defs/GitCommit"
            }
          },
          "required": [
            "event_type",
            "metadata"
          ],
          "type": "object"
        },
        {
          "properties": {
            "event_type": {
              "const": "git.checkout",
              "type": "string"
            },
            "metadata": {
              "$ref": "#/$defs/GitCheckout"
            }
          },
          "required": [
            "event_type",
            "metadata"
          ],
          "type": "object"
        },
        {
          "properties": {
            "event_type": {
              "const": "git.merge",
              "type": "string"
            },
            "metadata": {
              "$ref": "#/$defs/GitMerge"
            }
          },
          "required": [
            "event_type",
            "metadata"
          ],
          "type": "object"
        },
        {
          "properties": {
            "event_type": {
              "const": "git.backfill_commit",
              "type": "string"
            },
            "metadata": {
              "$ref": "#/$defs/GitBackfillCommit"
            }
          },
          "required": [
            "event_type",
            "metadata"
          ],
          "type": "object"
        },
        {
          "properties": {
            "event_type": {
              "const": "agent.heartbeat",
              "type": "string"
            },
            "metadata": {
              "$ref": "#/$defs/AgentHeartbeat"
            }
          },
          "required": [
            "event_type",
            "metadata"
          ],
          "type": "object"
        },
        {
          "properties": {
            "event_type": {
              "const": "agent.pause",
              "type": "string"
            },
            "metadata": {
              "$ref": "#/$defs/AgentPauseChange"
            }
          },
          "required": [
            "event_type",
            "metadata"
          ],
          "type": "object"
        },
        {
          "properties": {
            "event_type": {
              "const": "agent.resume",
              "type": "string"
            },
            "metadata": {
              "$ref": "#/$defs/AgentPauseChange"
            }
          },
          "required": [
            "event_type",
            "metadata"
          ],
          "type": "object"
        },
        {
          "description": "The local buffer hit its bound and dropped the oldest events (AGENT §3.1).",
          "properties": {
            "event_type": {
              "const": "agent.buffer_overflow",
              "type": "string"
            },
            "metadata": {
              "$ref": "#/$defs/AgentBufferOverflow"
            }
          },
          "required": [
            "event_type",
            "metadata"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/EventId"
        },
        "project_hint": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "repository": {
          "anyOf": [
            {
              "$ref": "#/$defs/RepositoryRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "timestamp_end": {
          "default": null,
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp_start": {
          "format": "date-time",
          "type": "string"
        },
        "working_directory": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "event_id",
        "schema_version",
        "timestamp_start",
        "source"
      ],
      "type": "object"
    },
    "EventId": {
      "description": "Event ID: a UUIDv7 generated by the collector. Time-sortable, so the\nwarehouse can deduplicate resends and the buffer keeps a natural order.",
      "format": "uuid",
      "type": "string"
    },
    "GitBackfillCommit": {
      "properties": {
        "branch": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "estimated": {
          "description": "Always `true`: backfilled time is an estimate.",
          "type": "boolean"
        },
        "hash": {
          "type": "string"
        }
      },
      "required": [
        "hash",
        "estimated"
      ],
      "type": "object"
    },
    "GitCheckout": {
      "properties": {
        "from_branch": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "to_branch": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "GitCommit": {
      "properties": {
        "branch": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "files_changed": {
          "default": null,
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "hash": {
          "type": "string"
        },
        "remote_url": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "hash"
      ],
      "type": "object"
    },
    "GitMerge": {
      "properties": {
        "branch": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "PauseReason": {
      "enum": [
        "user",
        "exclusion_window"
      ],
      "type": "string"
    },
    "RepositoryRef": {
      "description": "Repository context: local root and/or normalized remote (`github.com/acme/api`).",
      "properties": {
        "remote_url": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "root_path": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Source": {
      "description": "Collector `name@version`, e.g. `vscode@0.3.1`.",
      "maxLength": 128,
      "pattern": "^[^@]+@.+$",
      "type": "string"
    },
    "WindowFocus": {
      "properties": {
        "app": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "default": null,
          "description": "Redacted title.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`POST /v1/events:batch` body (gzip JSON, `Content-Encoding: gzip`).",
  "properties": {
    "batch_id": {
      "description": "Random per upload attempt; names the raw archive object (WH-6).",
      "format": "uuid",
      "type": "string"
    },
    "clock_offset_ms": {
      "description": "Device clock minus server clock, in milliseconds (see [`HeartbeatResponse`]).",
      "format": "int64",
      "type": "integer"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "type": "array"
    }
  },
  "required": [
    "batch_id",
    "clock_offset_ms",
    "events"
  ],
  "title": "BatchRequest",
  "type": "object"
}
