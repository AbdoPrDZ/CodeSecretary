{
  "$defs": {
    "EventId": {
      "description": "Event ID: a UUIDv7 generated by the collector. Time-sortable, so the\nwarehouse can deduplicate resends and the buffer keeps a natural order.",
      "format": "uuid",
      "type": "string"
    },
    "Rejection": {
      "properties": {
        "event_id": {
          "default": null,
          "description": "As sent; may be absent or malformed when that is the reason.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Short machine-readable reason, e.g. `invalid_timestamps`.",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "accepted": {
      "description": "Stored now.",
      "items": {
        "$ref": "#/$defs/EventId"
      },
      "type": "array"
    },
    "duplicates": {
      "description": "Already stored earlier; safe to forget.",
      "items": {
        "$ref": "#/$defs/EventId"
      },
      "type": "array"
    },
    "rejected": {
      "description": "Invalid; will never be accepted, so the agent drops them too.",
      "items": {
        "$ref": "#/$defs/Rejection"
      },
      "type": "array"
    },
    "server_time": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "accepted",
    "duplicates",
    "rejected",
    "server_time"
  ],
  "title": "BatchResponse",
  "type": "object"
}
